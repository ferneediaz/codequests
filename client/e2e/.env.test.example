# Copy to client/.env.test and fill in real values for the e2e suite.
#
# `client/e2e/setup/bootstrap-test-users.ts` reads SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY one-time to admin-create the four test users
# (alice/bob/carol/dave) at known passwords. After bootstrap, normal test
# runs only need VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY (already in
# client/.env) plus E2E_TEST_USER_PASSWORD to call signInWithPassword.

# Bootstrap-only (admin). Do NOT commit. Do NOT ship to CI without secret store.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# Used by bootstrap (to set) and by auth.setup (to sign in).
E2E_TEST_USER_PASSWORD=change-me-locally-only

# Optional: point Playwright at an already-running app instead of spawning Vite.
# PLAYWRIGHT_BASE_URL=http://localhost:5173
