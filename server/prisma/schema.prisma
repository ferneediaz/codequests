// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  avatarUrl String?
  role      String   @default("user") // "user" or "admin"

  // Stats
  mmr    Int @default(1000)
  wins   Int @default(0)
  losses Int @default(0)

  // Clan membership
  clanId String?
  clan   Clan?   @relation(fields: [clanId], references: [id])

  // Battle participation
  battles BattleParticipant[]

  // Matchmaking
  matchmakingEntry MatchmakingEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// CLANS
// ============================================

model Clan {
  id      String @id @default(uuid())
  name    String @unique
  tag     String @unique // e.g., [ABC]
  ownerId String

  // Clan MMR for clan vs clan battles
  mmr Int @default(1000)

  members User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// PROBLEMS
// ============================================

model Problem {
  id          String     @id @default(uuid())
  title       String
  description String
  difficulty  Difficulty @default(EASY)

  // Starter code as JSON: { "javascript": "...", "python": "..." }
  starterCode String @default("{}")

  testCases TestCase[]
  battles   Battle[]
  poolItems ProblemPoolItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestCase {
  id        String  @id @default(uuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  input          String
  expectedOutput String
  isHidden       Boolean @default(false) // Hidden tests not shown to user
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ============================================
// BATTLES
// ============================================

model Battle {
  id   String     @id @default(uuid())
  mode BattleMode @default(ONE_V_ONE)

  // For single-problem battles (1v1, battle royale)
  problemId String?
  problem   Problem? @relation(fields: [problemId], references: [id])

  // For multi-problem team battles (clan vs clan, group)
  problemPool ProblemPool?

  // Team battle settings
  teamSize         Int?             // 2, 3, or 5 for team battles
  timeLimitMinutes Int     @default(5)
  autoBalance      Boolean @default(true) // Auto-assign teams by MMR

  participants BattleParticipant[]

  winnerId    String? // For individual battles
  winningTeam String? // For team battles (team identifier)
  status      BattleStatus @default(WAITING)

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
}

model BattleParticipant {
  id       String @id @default(uuid())
  battleId String
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Team assignment for team battles
  teamId String? // "team-1" or "team-2" for team battles

  // Submission data
  code        String?
  language    String?
  testsPassed Int       @default(0)
  totalTests  Int       @default(0)
  submittedAt DateTime?

  // Scoring for team battles
  pointsEarned Int @default(0) // Sum of points from solved problems

  // MMR change after battle
  mmrChange Int?

  @@unique([battleId, userId])
}

enum BattleMode {
  ONE_V_ONE
  BATTLE_ROYALE
  CLAN_VS_CLAN
  GROUP
}

enum BattleStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

// ============================================
// MATCHMAKING
// ============================================

model MatchmakingEntry {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mode                BattleMode @default(ONE_V_ONE)
  preferredDifficulty Difficulty?
  mmrAtQueue          Int // Snapshot of user MMR when they joined

  status    MatchmakingStatus @default(QUEUED)
  queuedAt  DateTime          @default(now())
  matchedAt DateTime?
}

enum MatchmakingStatus {
  QUEUED
  MATCHED
  EXPIRED
}

// ============================================
// PROBLEM POOLS (for team battles)
// ============================================

model ProblemPool {
  id       String @id @default(uuid())
  battleId String @unique
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  items ProblemPoolItem[]
}

model ProblemPoolItem {
  id            String      @id @default(uuid())
  problemPoolId String
  problemPool   ProblemPool @relation(fields: [problemPoolId], references: [id], onDelete: Cascade)

  problemId String
  problem   Problem @relation(fields: [problemId], references: [id])

  // Point value based on difficulty (Easy=2, Medium=5, Hard=10)
  pointValue Int
}
