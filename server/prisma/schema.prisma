// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  avatarUrl String?
  role      String   @default("user") // "user" or "admin"

  // Stats
  mmr    Int @default(1000)
  wins   Int @default(0)
  losses Int @default(0)

  // Subscription
  subscriptionTier SubscriptionTier @default(FREE)
  stripeCustomerId String?          @unique
  gamesPlayedToday Int              @default(0)
  lastGameResetAt  DateTime         @default(now())
  trialEndsAt      DateTime?
  hasUsedTrial     Boolean          @default(false)
  subscription     Subscription?

  // Clan membership
  clanId String?
  clan   Clan?   @relation(fields: [clanId], references: [id])

  // Battle participation
  battles BattleParticipant[]

  // Season records
  seasonRecords SeasonRecord[]

  // Matchmaking
  matchmakingEntry MatchmakingEntry?

  // Friends
  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")

  // Chat
  sentMessages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubscriptionTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
}

model Subscription {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// CLANS
// ============================================

model Clan {
  id      String @id @default(uuid())
  name    String @unique
  tag     String @unique // e.g., [ABC]
  ownerId String

  // Clan MMR for clan vs clan battles
  mmr    Int @default(1000)
  wins   Int @default(0)
  losses Int @default(0)

  members User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// PROBLEMS
// ============================================

model Problem {
  id          String     @id @default(uuid())
  title       String
  description String
  difficulty  Difficulty @default(EASY)
  tags        String[]   @default([])

  // Starter code as JSON: { "javascript": "...", "python": "..." }
  starterCode String @default("{}")

  testCases TestCase[]
  battles   Battle[]
  poolItems ProblemPoolItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestCase {
  id        String  @id @default(uuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  input          String
  expectedOutput String
  isHidden       Boolean @default(false) // Hidden tests not shown to user
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ============================================
// BATTLES
// ============================================

model Battle {
  id   String     @id @default(uuid())
  mode BattleMode @default(ONE_V_ONE)

  // For single-problem battles (1v1, battle royale)
  problemId String?
  problem   Problem? @relation(fields: [problemId], references: [id])

  // For multi-problem team battles (clan vs clan, group)
  problemPool ProblemPool?

  // Team battle settings
  teamSize         Int?             // 2, 3, or 5 for team battles
  timeLimitMinutes Int     @default(5)
  autoBalance      Boolean @default(true) // Auto-assign teams by MMR

  // Skills enabled for this battle (toggleable per game)
  enabledSkills SkillType[] @default([])

  // Direct invite system
  inviteCode      String?   @unique // 8-char alphanumeric code (case-insensitive)
  inviteExpiresAt DateTime? // 24 hours after creation

  // Season reference
  seasonId String?
  season   Season? @relation(fields: [seasonId], references: [id])

  participants BattleParticipant[]
  skillUses    BattleSkillUse[]

  winnerId    String? // For individual battles
  winningTeam String? // For team battles (team identifier)
  status      BattleStatus @default(WAITING)

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
}

model BattleSkillUse {
  id       String @id @default(uuid())
  battleId String
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  userId       String    // The user who used the skill
  targetUserId String    // The user targeted by the skill
  skillType    SkillType
  usedAt       DateTime  @default(now())

  @@unique([battleId, userId, skillType]) // Each skill can only be used once per user per battle
}

model BattleParticipant {
  id       String @id @default(uuid())
  battleId String
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Team assignment for team battles
  teamId String? // "team-1" or "team-2" for team battles

  // Submission data
  code        String?
  language    String?
  testsPassed Int       @default(0)
  totalTests  Int       @default(0)
  submittedAt DateTime?

  // Scoring for team battles
  pointsEarned Int @default(0) // Sum of points from solved problems

  // Ready state for invite battles
  isReady Boolean @default(false)

  // MMR change after battle
  mmrChange Int?

  @@unique([battleId, userId])
}

enum BattleMode {
  ONE_V_ONE
  BATTLE_ROYALE
  CLAN_VS_CLAN
  GROUP
}

enum BattleStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

enum SkillType {
  FREEZE       // Lock opponent's editor for 10 seconds
  SCRAMBLE     // Shuffle opponent's code lines instantly
  BLIND        // Hide opponent's test case results until next submission
  TIME_STEAL   // Reduce opponent's remaining time by 60 seconds
  FOG_OF_WAR   // Blur opponent's screen for 20 seconds
}

// ============================================
// MATCHMAKING
// ============================================

model MatchmakingEntry {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mode                BattleMode @default(ONE_V_ONE)
  preferredDifficulty Difficulty?
  preferredTopic      String?
  mmrAtQueue          Int // Snapshot of user MMR when they joined

  status    MatchmakingStatus @default(QUEUED)
  queuedAt  DateTime          @default(now())
  matchedAt DateTime?
}

enum MatchmakingStatus {
  QUEUED
  MATCHED
  EXPIRED
}

// ============================================
// PROBLEM POOLS (for team battles)
// ============================================

model ProblemPool {
  id       String @id @default(uuid())
  battleId String @unique
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  items ProblemPoolItem[]
}

model ProblemPoolItem {
  id            String      @id @default(uuid())
  problemPoolId String
  problemPool   ProblemPool @relation(fields: [problemPoolId], references: [id], onDelete: Cascade)

  problemId String
  problem   Problem @relation(fields: [problemId], references: [id])

  // Point value based on difficulty (Easy=2, Medium=5, Hard=10)
  pointValue Int
}

// ============================================
// SEASONS
// ============================================

model Season {
  id       String  @id @default(uuid())
  number   Int     @unique // 1, 2, 3, ...
  name     String  // "Season 1", "Season 2", ...
  isActive Boolean @default(false)

  startDate DateTime
  endDate   DateTime

  battles Battle[]
  records SeasonRecord[]

  createdAt DateTime @default(now())
}

model SeasonRecord {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  peakMmr       Int
  peakRankTier  String // e.g. "Cracked", "10x Dev"
  finalMmr      Int
  finalRankTier String
  wins          Int   @default(0)
  losses        Int   @default(0)
  winRate       Float @default(0)

  isDisplayed Boolean @default(false) // User toggle for profile display

  createdAt DateTime @default(now())

  @@unique([userId, seasonId])
}

// ============================================
// FRIENDS
// ============================================

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Friendship {
  id String @id @default(uuid())

  requesterId String
  requester   User   @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId String
  addressee   User   @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status FriendshipStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
}

// ============================================
// CHAT
// ============================================

enum ChatRoomType {
  BATTLE
  LOBBY
  DM
}

enum ConversationType {
  DM
  GROUP
}

model Message {
  id       String @id @default(uuid())
  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content  String
  roomType ChatRoomType
  roomId   String // battleId, "lobby", or conversationId

  createdAt DateTime @default(now())

  @@index([roomType, roomId, createdAt])
}

model Conversation {
  id             String           @id @default(uuid())
  type           ConversationType @default(DM)
  participantIds String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
