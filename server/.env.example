# Database (Supabase PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT Public Key (ES256 JWK format - get from Supabase Dashboard > Settings > API > JWT Public Key)
JWT_JWK={"x":"...","y":"...","alg":"ES256","crv":"P-256","kty":"EC","key_ops":["verify"]}

# Piston Code Execution Engine
PISTON_URL=http://localhost:2000

# App
PORT=3000
NODE_ENV=development

# --- Developer Pro allowlist ---------------------------------------------
# Grants Pro entitlement (unlimited games, no Stripe checkout) to the listed
# user ids and/or emails. Useful when developing locally so you are not
# tied to the 1-game-per-day free limit. Leave empty in production.
# Both vars are comma-separated. Email matching is case-insensitive.
DEV_PRO_USER_IDS=
DEV_PRO_EMAILS=

# --- Stripe / Subscriptions -----------------------------------------------
# Secret key from https://dashboard.stripe.com/apikeys (use sk_test_... in dev).
STRIPE_SECRET_KEY=
# Webhook signing secret. Local dev: run
#   stripe listen --forward-to localhost:3000/api/subscriptions/webhook
# and paste the printed `whsec_...` here. Production: copy from the
# webhook endpoint you create in the dashboard.
STRIPE_WEBHOOK_SECRET=
# Price IDs from your Stripe dashboard. The /pricing page sells $5/2mo and
# $24.99/year so the bimonthly price MUST be created with
# interval=month, interval_count=2 (NOT a plain monthly price).
STRIPE_PRICE_ID_BIMONTHLY=
STRIPE_PRICE_ID_YEARLY=

# Used to build Stripe success_url / cancel_url / portal return_url.
# Set to your deployed frontend in production.
CLIENT_URL=http://localhost:5173

# AUTHORING: enable dev-only authoring tools (GET /author/*)
# for testing questions and problems locally.
ENABLE_AUTHOR_TOOLS=true

# --- GitHub activity heatmap ---------------------------------------------
# Shared token used to query the GitHub GraphQL contribution calendar
# (full-year heat) for any GH login stored on `User.githubUsername`.
# A single token covers every user we render — read-only public scope.
# Without this, the server falls back to the public events API, which
# only covers ~last 90 days (PushEvents only).
# Create a fine-grained PAT with NO scopes at
# https://github.com/settings/tokens?type=beta and paste it here.
GITHUB_TOKEN=